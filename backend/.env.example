# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/roboss?schema=public"

# JWT
JWT_SECRET="replace-with-a-strong-32-plus-char-secret"
JWT_REFRESH_SECRET="replace-with-a-different-strong-32-plus-char-secret"
SCAN_TOKEN_SECRET="replace-with-a-dedicated-strong-32-plus-char-secret"
SCAN_TOKEN_TTL_SECONDS=300

# Clerk
# Fill these when migrating customer auth to Clerk.
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_JWT_KEY=""
CLERK_WEBHOOK_SECRET=""
CLERK_AUTH_MODE="legacy"

# LINE Login
LINE_CHANNEL_ID="your-line-channel-id"
LINE_CHANNEL_SECRET="your-line-channel-secret"
LINE_LIFF_ID=""
LINE_OFFICIAL_ACCOUNT_BASIC_ID=""
LINE_RICH_MENU_ID=""

# LINE Official Account Messaging API
LINE_MESSAGING_CHANNEL_SECRET=""
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=""
LINE_CUSTOMER_PORTAL_URL=http://localhost:5173
CUSTOMER_PORTAL_URL=http://localhost:5173
# Optional for `npm run line:rich-menu`
LINE_RICH_MENU_IMAGE_PATH=""
LINE_RICH_MENU_SET_DEFAULT=false

# MQTT (IoT)
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TOPIC_PREFIX="roboss"

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
AUTH_ALLOW_DEV_LOGIN=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Payments
# Provider options: mock_promptpay (dev), stripe (production), ksher (production)
# Branch-level config (BranchPaymentConfig) overrides this per-branch.
BRANCH_PAYMENT_CREDENTIAL_SECRET=replace-with-a-strong-secret-for-credential-encryption
PAYMENT_PROVIDER_NAME=ksher
PAYMENT_PROVIDER_WEBHOOK_SECRET=change-me
PAYMENT_ALLOW_MANUAL_CONFIRM=true
SLIPMATE_API_KEY=

# Generic REST payment provider (optional, used when PAYMENT_PROVIDER_NAME is neither mock_promptpay, stripe, nor ksher)
PAYMENT_PROVIDER_CREATE_URL=
PAYMENT_PROVIDER_VERIFY_URL=
PAYMENT_PROVIDER_VERIFY_METHOD=GET
PAYMENT_PROVIDER_CALLBACK_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_AUTH_HEADER=Authorization
PAYMENT_PROVIDER_AUTH_SCHEME=Bearer
PAYMENT_PROVIDER_WEBHOOK_SECRET_HEADER=x-payment-webhook-secret
PAYMENT_PROVIDER_SIGNATURE_SECRET=
PAYMENT_PROVIDER_SIGNATURE_HEADER=x-payment-signature
PAYMENT_PROVIDER_SIGNATURE_PREFIX=
PAYMENT_PROVIDER_SIGNATURE_ALGORITHM=sha256

# Stripe (required when PAYMENT_PROVIDER_NAME=stripe or any branch uses stripe provider)
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXX

# Ksher (required when PAYMENT_PROVIDER_NAME=ksher or any branch uses ksher provider)
# Get credentials from https://merchant.ksher.net/
KSHER_APP_ID=mchXXXXX
KSHER_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
KSHER_NOTIFY_URL=https://your-domain.com/api/payments/webhook/provider

# Machine events / IoT
MACHINE_EVENT_SECRET=change-me-before-staging
ALLOW_SIMULATED_WASH=true

# Smoke tests
ROBOSS_SMOKE_BASE_URL=http://localhost:3001
ROBOSS_SMOKE_ADMIN_EMAIL=
ROBOSS_SMOKE_ADMIN_PASSWORD=

